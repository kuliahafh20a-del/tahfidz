# Shared
APP_ENV=development
APP_VERSION=0.1.0
WEB_PORT=3000
API_PORT=8000
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_CONSOLE_PORT=9001

# PostgreSQL development
POSTGRES_DB=yaqin
POSTGRES_USER=yaqin
POSTGRES_PASSWORD=change-me-local-only

# API — replace every placeholder outside local development
DATABASE_URL=postgresql+psycopg://yaqin:change-me-local-only@db:5432/yaqin
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=30000
BUSINESS_TIMEZONE=Asia/Jakarta
SESSION_SECRET=change-me-with-at-least-32-random-characters
CSRF_SECRET=change-me-with-at-least-32-random-characters
SESSION_TTL_SECONDS=43200
RECOVERY_TOKEN_TTL_SECONDS=1800
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
RECOVERY_RATE_LIMIT_ATTEMPTS=3
RECOVERY_RATE_LIMIT_WINDOW_SECONDS=3600
ALLOWED_HOSTS=localhost,127.0.0.1
TRUSTED_PROXY_COUNT=1
OBJECT_STORAGE_ENDPOINT=http://object-storage:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=yaqin-private
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=change-me
OBJECT_STORAGE_SECRET_KEY=change-me
SIGNED_URL_TTL_SECONDS=300
AUDIO_ALLOWED_CONTENT_TYPES=audio/mp4,audio/mpeg,audio/ogg,audio/webm
AUDIO_MAX_SIZE_BYTES=10485760
MEDIA_WORKER_POLL_SECONDS=2
MEDIA_VALIDATION_MAX_ATTEMPTS=5
VIDEO_ALLOWED_HOSTS=youtube.com,www.youtube.com,youtu.be
LOG_LEVEL=INFO

# Web — NEXT_PUBLIC_* values are intentionally public
INTERNAL_API_BASE_URL=http://api:8000/api/v1
NEXT_PUBLIC_APP_NAME=YAQin
NEXT_PUBLIC_BASE_URL=http://localhost
NEXT_TELEMETRY_DISABLED=1

