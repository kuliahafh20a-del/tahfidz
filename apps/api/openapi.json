        "required": [
          "curriculum_version_id",
          "policy_version_id",
          "name",
          "start_date"
        ],
        "title": "CohortCreate",
        "type": "object"
      },
      "CohortResponse": {
        "description": "A cohort visible inside one department scope.",
        "properties": {
          "close_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Close Date"
          },
          "curriculum_version_id": {
            "format": "uuid",
            "title": "Curriculum Version Id",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "organization_id": {
            "format": "uuid",
            "title": "Organization Id",
            "type": "string"
          },
          "policy_version_id": {
            "format": "uuid",
            "title": "Policy Version Id",
            "type": "string"
          },
          "start_date": {
            "format": "date",
            "title": "Start Date",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/CohortStatus"
          }
        },
        "required": [
          "id",
          "organization_id",
          "curriculum_version_id",
          "policy_version_id",
          "name",
          "start_date",
          "close_date",
          "status"
        ],
        "title": "CohortResponse",
        "type": "object"
      },
