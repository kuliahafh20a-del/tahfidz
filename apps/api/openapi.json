        "description": "Mutable enrollment fields that preserve identity and cohort history.",
        "properties": {
          "nim_snapshot": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nim Snapshot"
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EnrollmentStatus"
              },
