        "title": "EnrollmentDetail",
        "type": "object"
      },
      "EnrollmentResponse": {
        "description": "Participant enrollment summary for J01.",
        "properties": {
          "cohort_id": {
            "format": "uuid",
            "title": "Cohort Id",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "joined_at": {
            "format": "date-time",
            "title": "Joined At",
            "type": "string"
          },
          "nim_snapshot": {
            "title": "Nim Snapshot",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/EnrollmentStatus"
          },
          "user": {
            "$ref": "#/components/schemas/UserReference"
