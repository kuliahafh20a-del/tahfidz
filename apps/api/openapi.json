        "properties": {
          "policy_id": {
            "format": "uuid",
            "title": "Policy Id",
            "type": "string"
          },
          "policy_version": {
            "title": "Policy Version",
            "type": "string"
          },
          "score": {
            "$ref": "#/components/schemas/IntegerScorePolicy"
          }
        },
        "required": ["policy_id", "policy_version", "score"],
        "title": "AssessmentRubricResponse",
        "type": "object"
      },
      "AssignmentCreate": {
        "description": "Assign one qualified staff account and close the prior active interval.",
        "properties": {
          "assignee_user_id": {
            "format": "uuid",
            "title": "Assignee User Id",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "role": {
            "$ref": "#/components/schemas/AssignmentRole"
          },
          "valid_from": {
            "format": "date-time",
            "title": "Valid From",
            "type": "string"
          },
          "valid_to": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid To"
          }
        },
        "required": ["role", "assignee_user_id", "valid_from"],
        "title": "AssignmentCreate",
        "type": "object"
      },
      "AssignmentEnd": {
        "description": "Close an active assignment without deleting its history.",
        "properties": {
          "ended_at": {
            "format": "date-time",
            "title": "Ended At",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "title": "AssignmentEnd",
        "type": "object"
      },
      "AssignmentResponse": {
        "description": "One historical or active Mentor/Lecturer assignment.",
        "properties": {
          "enrollment_id": {
            "format": "uuid",
            "title": "Enrollment Id",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "role": {
            "$ref": "#/components/schemas/AssignmentRole"
          },
          "staff": {
            "$ref": "#/components/schemas/UserReference"
          },
          "valid_from": {
            "format": "date-time",
            "title": "Valid From",
            "type": "string"
          },
          "valid_to": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid To"
          }
        },
        "required": [
          "id",
          "enrollment_id",
          "staff",
          "role",
          "valid_from",
          "valid_to",
          "reason"
        ],
        "title": "AssignmentResponse",
        "type": "object"
      },
      "AssignmentRole": {
        "description": "Staff capacities that may be assigned to an enrollment.",
        "enum": ["mentor", "lecturer"],
        "title": "AssignmentRole",
        "type": "string"
      },
      "CohortCreate": {
        "description": "Create one department-owned cohort.",
        "properties": {
          "close_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
