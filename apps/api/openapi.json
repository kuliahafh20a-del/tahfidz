        "description": "Lifecycle states for one department program cohort.",
        "enum": ["draft", "active", "closed", "archived"],
        "title": "CohortStatus",
        "type": "string"
      },
      "CurriculumResponse": {
        "description": "The complete effective curriculum reference tree.",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "parts": {
            "items": {
              "$ref": "#/components/schemas/PartResponse"
            },
            "title": "Parts",
            "type": "array"
          },
          "published_at": {
            "format": "date-time",
            "title": "Published At",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": ["id", "version", "title", "published_at", "parts"],
        "title": "CurriculumResponse",
        "type": "object"
      },
      "EnrollmentCreate": {
        "description": "Enroll an existing participant account in a scoped cohort.",
        "properties": {
          "cohort_id": {
            "format": "uuid",
            "title": "Cohort Id",
            "type": "string"
          },
          "nim_snapshot": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Nim Snapshot",
            "type": "string"
