        "description": "The DEC-001 score scale exposed to every scoring interface.",
        "properties": {
          "allow_fractional": {
            "default": false,
            "title": "Allow Fractional",
            "type": "boolean"
          },
          "bands": {
            "items": {
              "$ref": "#/components/schemas/RubricBand"
            },
            "minItems": 3,
            "title": "Bands",
            "type": "array"
          },
          "display_decimals": {
            "default": 0,
            "title": "Display Decimals",
            "type": "integer"
          },
          "maximum": {
            "default": 10,
            "title": "Maximum",
            "type": "integer"
          },
          "minimum": {
            "default": 1,
            "title": "Minimum",
            "type": "integer"
          },
          "step": {
            "default": 1,
            "title": "Step",
            "type": "integer"
          }
        },
        "required": ["bands"],
        "title": "IntegerScorePolicy",
        "type": "object"
      },
      "PartResponse": {
        "description": "One ordered curriculum part.",
        "properties": {
          "sequence_no": {
            "title": "Sequence No",
            "type": "integer"
          },
          "themes": {
            "items": {
              "$ref": "#/components/schemas/ThemeResponse"
            },
            "title": "Themes",
            "type": "array"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": ["sequence_no", "title", "themes"],
        "title": "PartResponse",
        "type": "object"
      },
      "PolicySummary": {
        "description": "The effective policy version without unrelated rule internals.",
        "properties": {
          "effective_from": {
            "format": "date-time",
            "title": "Effective From",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": ["id", "version", "status", "effective_from"],
        "title": "PolicySummary",
        "type": "object"
      },
      "RubricBand": {
        "description": "An inclusive integer score band and its approved description.",
        "properties": {
          "description": {
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "maximum": {
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Maximum",
            "type": "integer"
          },
          "minimum": {
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Minimum",
            "type": "integer"
          }
        },
        "required": ["minimum", "maximum", "description"],
        "title": "RubricBand",
        "type": "object"
      },
      "ThemeRangeResponse": {
        "description": "An inclusive Juz 30 verse range.",
        "properties": {
          "ayah_end": {
            "title": "Ayah End",
            "type": "integer"
          },
          "ayah_start": {
            "title": "Ayah Start",
            "type": "integer"
          },
          "sequence_no": {
            "title": "Sequence No",
            "type": "integer"
          },
          "surah_no": {
            "title": "Surah No",
            "type": "integer"
          }
        },
        "required": ["sequence_no", "surah_no", "ayah_start", "ayah_end"],
        "title": "ThemeRangeResponse",
        "type": "object"
      },
      "ThemeResponse": {
        "description": "An ordered curriculum theme with one or more verse ranges.",
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "ranges": {
            "items": {
              "$ref": "#/components/schemas/ThemeRangeResponse"
            },
            "title": "Ranges",
            "type": "array"
          },
          "sequence_no": {
            "title": "Sequence No",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": ["sequence_no", "title", "description", "ranges"],
        "title": "ThemeResponse",
        "type": "object"
      },
      "UserReference": {
        "description": "Minimal account information needed by the J01 workspace.",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "login_identifier": {
            "title": "Login Identifier",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": ["id", "name", "login_identifier"],
        "title": "UserReference",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": ["loc", "msg", "type"],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
